#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                     &kp W    &kp E           &kp R        &lt 4 T        &kp Y          &kp U           &lt 4 I          &kp O           &kp P          &kp LBKT  
            &kp Q    &kp S    &mt LALT D      &mt LCTRL F  &mt LSHIFT G   &lt 1 H        &lt 1 J         &mt RSHIFT K     &mt RCTRL L     &mt RALT SEMI  &kp SQT     &kp RBKT
            &kp A    &kp Z    &kp X           &kp C        &kp V          &lt 2 B        &lt 2 N         &kp M            &kp COMMA       &kp DOT        &kp SLASH   &kp BSLH
                                                           &kp ESCAPE      &kp SPACE      &kp ENTER       &kp BSPC
            >;
        };
        l1 { // Layer 1
            display-name = "L1";
            bindings = <
                    &kp N2    &kp N3          &kp N4       &kp N5         &kp N6         &kp N7          &kp N8           &kp N9          &kp N0         &kp MINUS
            &kp N1   &trans    &kp GRAVE       &kp LBRC     &kp RBRC       &kp LEFT       &kp DOWN        &kp UP           &kp RIGHT       &trans         &trans      &kp EQUAL
            &trans  &trans    &trans          &trans       &trans         &trans         &trans          &trans           &kp LPAR        &kp RPAR       &trans      &trans
                                                           &kp LGUI       &trans         &kp TAB         &kp F5
            >;
        };
        l2 { // Layer 2
            display-name = "L2";
            bindings = <
                    &kp F2    &kp F3         &kp F4        &kp F5        &kp F6          &kp F7          &kp F8           &kp F9          &kp F10        &kp F11
            &kp F1  &kp PSCRN &trans         &trans        &trans        &kp HOME        &kp PG_DN       &kp PG_UP        &kp END         &trans         &kp INS     &kp F12
            &trans  &trans    &trans         &trans        &trans        &trans          &trans          &trans           &trans          &trans         &trans      &trans
                                                           &trans        &kp CAPS        &tog 3          &trans
            >;
        };
        mouse { // Layer 3
            display-name = "Mouse";
            bindings = <
                    &trans    &trans         &trans        &trans        &trans          &mkp MB1        &trans           &mkp MB2        &msc SCRL_UP   &trans
            &trans  &trans    &trans         &trans        &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT &msc SCRL_DOWN &trans      &trans
            &trans  &trans    &trans         &trans        &trans        &trans          &trans          &trans           &trans          &trans         &trans      &trans
                                                           &trans        &trans          &tog 3          &trans
            >;
        };
        special { // Layer 4
            display-name="Special";
            bindings = <
                    &kp LGUI  &mt LALT TAB   &mt LCTRL TAB &kp UNDER     &kp KP_MINUS    &kp KP_PLUS     &kp KP_EQUAL     &mt RCTRL TAB   &mt RALT TAB   &kp RGUI
         &kp TILDE  &kp EXCL  &kp AT         &kp HASH      &kp DLLR      &kp PRCNT       &kp AMPS        &kp STAR         &kp LPAR        &kp RPAR       &kp MINUS   &kp PLUS
    &studio_unlock  &trans    &kp PIPE       &kp COLON     &kp DQT       &kp QMARK       &lt 2 N         &kp LT           &kp GT          &kp CARET      &trans      &studio_unlock 
                                                           &trans        &kp TAB         &trans          &trans 
            >;
        };
    };
 };
